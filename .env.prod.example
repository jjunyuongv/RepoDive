# 프로덕션 배포용 환경변수 예시. 복사해서 값을 채운다:
#   cp .env.prod.example .env.prod
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# **.env.prod 는 커밋되지 않는다** (.gitignore 의 `.env.*`).
#
# 이 파일은 `Back/.env.example` 을 대신하지 않는다. 그쪽이 **전체 목록**이고
# (`Back/tests/test_config.py` 가 config.py 와 양방향으로 대조한다),
# 여기 있는 것은 **배포에서 값이 달라지는 것과 비밀뿐**이다.
# 나머지 설정은 이미지에 구워진 기본값과 ENV 로 돈다.


# ── 비밀 ────────────────────────────────────────────────────

# Claude API 키. 없으면 /analyze 가 503 이다.
ANTHROPIC_API_KEY=

# GitHub 개인 액세스 토큰. 없으면 API 한도가 시간당 60회(있으면 5,000회).
# public repo 만 읽으므로 스코프 없는 토큰이면 충분하다.
GITHUB_TOKEN=

# DB 비밀번호. **compose 가 이 값 하나로 DATABASE_URL 을 조립한다** —
# 접속 문자열을 따로 적지 않는다(두 곳에 적으면 한쪽만 바뀌어 조용히 깨진다).
POSTGRES_PASSWORD=


# ── 배치 ────────────────────────────────────────────────────

# 서비스가 실제로 서빙되는 출처. FRONTEND_ORIGIN 으로 들어간다.
# 같은 출처라 CORS 요청 자체가 안 생기지만, 도메인이 갈리는 날 이 값이 유일한
# 허용 목록이다. 7단계(HTTPS·도메인) 뒤에는 https://<도메인> 이 된다.
PUBLIC_ORIGIN=http://localhost

# 분석을 허용할 저장소. `owner/name` 을 쉼표로 잇는다. **비어 있으면 제한이 꺼진다** —
# URL 을 아는 누구나 임의 저장소로 LLM 비용과 색인 CPU 를 쓴다. 서비스 전체 상한은
# 합산이라 한 명이 나머지를 막을 수 있다. **공개 배포에서는 비워 두지 말 것.**
# (로그인을 켜도 이 값은 따로 필요하다 — 로그인은 누가 썼는지를 알려줄 뿐이다.)
# 여기에 저장소 이름을 예시로도 적지 않는다 — 적으면 그것이 기본 목록처럼 굳는다
# (docs/architecture.md §3). 전체 설명은 Back/.env.example 에 있다.
ALLOWED_REPOS=

# DB 이름·계정. 기본값 repodive 로 충분하다. 바꾸면 볼륨을 새로 만들어야 한다
# (POSTGRES_* 는 데이터 디렉터리가 비어 있을 때만 적용된다).
#POSTGRES_DB=repodive
#POSTGRES_USER=repodive


# ── 로그인 (GitHub OAuth) — **지금은 비워 둔다** ────────────
#
# 비어 있으면 로그인 기능이 통째로 꺼지고, 그 상태의 동작은 로그인 도입 전과 같다.
# **지금 배포가 그 상태다.**
#
# 켤 수 없는 이유는 콜백 URL 이다 — OAuth App 은 콜백의 host·port 가 정확히 일치해야
# 하는데, 이 인스턴스는 껐다 켤 때마다 퍼블릭 IP 가 바뀐다(Elastic IP 를 안 붙였다).
# **도메인이 생긴 뒤에 켠다** — 그때
# 운영용 OAuth App 을 새로 만들고(로컬 앱을 고쳐 쓰지 않는다) 콜백을
# `https://<도메인>/auth/callback` 으로 등록한 뒤 아래 둘을 채운다.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=


# ── 여기에 적지 않는 것 ─────────────────────────────────────
#
# DATABASE_URL        compose 가 db 서비스를 가리키게 조립한다
# TRUST_PROXY_HEADERS compose 가 1 로 고정한다 (nginx 뒤이므로)
# COOKIE_SECURE       비워 두면 PUBLIC_ORIGIN 이 https 인지로 유도된다
# EMBEDDING_*         이미지에 ENV 로 구워져 있다. **여기서 덮으면 안 된다** —
#                     가중치는 그 값으로 구워졌고, 다른 값이면 런타임이 이미지의
#                     모델을 두고 다시 받는다
